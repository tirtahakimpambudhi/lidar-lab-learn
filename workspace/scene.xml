<mujoco model="ekf_slam_lidar_lab">
  <compiler angle="radian" coordinate="local" autolimits="true"/>
  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>
  <size njmax="1000" nconmax="200"/>

  <default>
    <geom friction="0.8 0.1 0.1" condim="3" solref="0.02 1"/>
  </default>

  <visual>
    <headlight ambient="0.5 0.5 0.5" diffuse="0.8 0.8 0.8" specular="0.1 0.1 0.1"/>
    <global offwidth="1200" offheight="900"/>
  </visual>

  <worldbody>
    <light pos="0 0 6" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" pos="0 0 0" size="5 4.5 0.1" rgba="0.92 0.92 0.92 1"/>

    <!-- Room interior is approximately x=[-4,4], y=[-3.5,3.5]. -->
    <geom name="wall_east" type="box" pos="4.1 0 0.5" size="0.1 3.6 0.5" rgba="0.45 0.48 0.52 1"/>
    <geom name="wall_west" type="box" pos="-4.1 0 0.5" size="0.1 3.6 0.5" rgba="0.45 0.48 0.52 1"/>
    <geom name="wall_north" type="box" pos="0 3.6 0.5" size="4.1 0.1 0.5" rgba="0.45 0.48 0.52 1"/>
    <geom name="wall_south" type="box" pos="0 -3.6 0.5" size="4.1 0.1 0.5" rgba="0.45 0.48 0.52 1"/>

    <!-- Static cylindrical landmarks, radius = 0.12 m. -->
    <geom name="landmark_0" type="cylinder" pos="-1.25 1.05 0.45" size="0.12 0.45" rgba="0.85 0.18 0.16 1"/>
    <geom name="landmark_1" type="cylinder" pos="1.05 1.15 0.45" size="0.12 0.45" rgba="0.16 0.48 0.82 1"/>
    <geom name="landmark_2" type="cylinder" pos="-1.15 -1.15 0.45" size="0.12 0.45" rgba="0.18 0.65 0.35 1"/>
    <geom name="landmark_3" type="cylinder" pos="1.20 -1.10 0.45" size="0.12 0.45" rgba="0.75 0.48 0.08 1"/>
    <geom name="landmark_4" type="cylinder" pos="0.05 0.05 0.45" size="0.12 0.45" rgba="0.65 0.25 0.75 1"/>

    <!-- Kinematic base: its pose is updated by the demo script; MuJoCo performs real ray casts against this scene. -->
    <body name="robot" pos="2 0 0.20">
      <freejoint name="robot_free"/>
      <geom name="robot_chassis" type="box" pos="0 0 0" size="0.20 0.15 0.10" mass="5" rgba="0.12 0.12 0.14 1"/>
      <site name="lidar_site" pos="0 0 0.15" size="0.025" rgba="0.05 0.05 0.05 1"/>
    </body>
  </worldbody>
</mujoco>
